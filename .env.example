# ============================================
# Local development: copy to .env (gitignored). On Vercel, set the same variables in
# Project Settings -> Environment Variables of the project that serves www.pro-algo.com.
# Without them the site still builds; the payment pages say they are not configured.
# ============================================

# Postgres. On Vercel: Storage -> Neon, connected to the project, sets DATABASE_URL itself.
# Locally, for example:
#   docker run -d --name proalgo-pg -e POSTGRES_PASSWORD=devpass -p 127.0.0.1:54329:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:devpass@127.0.0.1:54329/postgres

# Sign-in for /pay-link (checked on the server by /api/pay/login)
PAY_ADMIN_USER=admin
PAY_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Key used to encrypt the payment link parameters (?d=...).
# Changing it invalidates every link already sent out.
PAY_LINK_SECRET=change-me-to-a-long-random-string

# Shared with Toro (cars-server PRO_ALGO_PAY_WEBHOOK_SECRET): Toro sends it when it reports a payment
# to /api/pay/paid. A long random string.
PAY_WEBHOOK_SECRET=change-me-to-another-long-random-string

# Optional: signs the /pay-link session cookie. Defaults to a key derived from the two values above.
# PAY_SESSION_SECRET=

# Set to 1 to also accept readable params on /pay (?amount=...&desc=...).
# Leave at 0 so only encrypted links can prefill the page.
PAY_ALLOW_PLAIN_PARAMS=0

# Environment the embedded Grow widget talks to: PRODUCTION or DEV.
# Must match CREDIT_CARD_ENVIRONMENT on cars-server.
PAY_GROW_ENVIRONMENT=PRODUCTION

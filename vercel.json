{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m venv .venv && .venv/bin/pip install markdown pillow",
  "buildCommand": ".venv/bin/python tools/build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "agent.pro-algorithm.co.il" }],
      "destination": "https://auth-cad-core.base44.app/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cursor.pro-algorithm.co.il" }],
      "destination": "https://cursor.buildalgo.co.il/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "superposition.pro-algorithm.co.il" }],
      "destination": "https://superposition.buildalgo.co.il/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/pay", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment.html" },
    { "source": "/payment", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment.html" },
    { "source": "/תשלום", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment.html" },
    { "source": "/pay-link", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment-link.html" },
    { "source": "/create-payment-link", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment-link.html" },
    { "source": "/payment-link", "destination": "https://landing-page-sooty-alpha-16.vercel.app/payment-link.html" },
    { "source": "/js/:path*", "destination": "https://landing-page-sooty-alpha-16.vercel.app/js/:path*" },
    { "source": "/images/:path*", "destination": "https://landing-page-sooty-alpha-16.vercel.app/images/:path*" },
    { "source": "/style.css", "destination": "https://landing-page-sooty-alpha-16.vercel.app/style.css" },
    { "source": "/favicon.png", "destination": "https://landing-page-sooty-alpha-16.vercel.app/favicon.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
